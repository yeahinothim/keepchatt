{
  "entities": {
    "Message": {
      "title": "Message",
      "description": "A chat message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "targetType": { "type": "string", "enum": ["channel", "dm"] },
        "targetId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "targetType", "targetId", "senderId", "senderName", "text", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "A user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "displayName": { "type": "string" }
      },
      "required": ["id", "username"]
    }
  },
  "firestore": {
    "/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "All chat messages"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "All users"
    }
  }
}
